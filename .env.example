APP_NAME=XBoard
APP_ENV=production
APP_KEY=base64:PZXk5vTuTinfeEVG5FpYv2l6WEhLsyvGpiWK7IgJJ60=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xboard
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# google cloud storage
ENABLE_AUTO_BACKUP_AND_UPDATE=false

# Hop Java traffic Outbox is consumed only by Xboard's node control plane.
# Enable only after Hop Flyway V007 and the Xboard WebSocket worker are ready.
XBOARD_JAVA_TRAFFIC_OUTBOX_CONSUMER_ENABLED=false
XBOARD_JAVA_TRAFFIC_OUTBOX_BATCH_SIZE=100
XBOARD_JAVA_TRAFFIC_OUTBOX_CLAIM_LEASE_SECONDS=120
XBOARD_JAVA_TRAFFIC_OUTBOX_RETRY_BASE_SECONDS=5
XBOARD_JAVA_TRAFFIC_OUTBOX_RETRY_MAX_SECONDS=300
GOOGLE_CLOUD_KEY_FILE=config/googleCloudStorageKey.json
GOOGLE_CLOUD_STORAGE_BUCKET=

# Prevent reinstallation
INSTALLED=false
